# Build output
/build/
/target/
*.o
*.a
*.so
*.dylib
/third_party/bedstead/tools/dump_glyphs

# Test corpus and captures: downloaded at test time, never committed (REQ-TST-022)
/corpus/
*.ts
*.m2ts
*.t42
*.vbi
*.tbc

# Copyrighted source material must not be committed
*.pdf
*.PDF

# Editor and OS files
.DS_Store
*.swp
.vscode/
.idea/

# Scratch work: probes, browser profile
/tmp/

# The linked test image of REQ-GEN-009 is its own workspace (decision E.61).
/firmware/test-image/target/

# Local agent state: worktrees and settings of Claude Code sessions
/.claude/

# Fuzzing output (fuzz/.gitignore covers the fuzz workspace itself)
/fuzz/target/
/fuzz/corpus/
/fuzz/artifacts/
/fuzz/coverage/

# Backups made before overwriting files
*.bak
*.bak-*
*.orig
*~

# Secrets never enter the repository
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.mobileprovision
credentials/
